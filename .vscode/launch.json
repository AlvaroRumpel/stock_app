    "version": "0.2.0",
    "configurations": [
        {
            "name": "Dev Debug",
            "request": "launch",
            "type": "dart",
            "flutterMode": "debug",
            "args": [
                "--flavor", "dev",
                "--dart-define-from-file=dart_defines/dev.json"
            ]
        },
        {
            "name": "Dev Release",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                "--flavor", "dev",
                "--dart-define-from-file=dart_defines/dev.json"
            ]
        },
        {
            "name": "Production Release",
            "request": "launch",
            "type": "dart",
            "flutterMode": "release",
            "args": [
                "--flavor", "production",
                "--dart-define-from-file=dart_defines/production.json"
            ]
        }
    ]
}
